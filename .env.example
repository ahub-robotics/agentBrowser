# Optionally reference an existing file instead of setting the values below:
# AGENTRUN_ENV_FILE=/absolute/path/to/.env

TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none

# Optional evidence reviewer overrides. Empty values reuse TEXT_MODEL configuration.
# Reviews use independent requests, counters and budgets; TYPE_TEXT keeps its own helper.
VERIFICATION_API_KEY=
VERIFICATION_BASE_URL=
VERIFICATION_MODEL=
VERIFICATION_REASONING=

# Optional supervisor overrides. Empty values reuse the effective VERIFICATION_* configuration.
# Only --supervised / SupervisedAgent uses these; Jev and TYPE_TEXT keep their own models.
SUPERVISOR_API_KEY=
SUPERVISOR_BASE_URL=
SUPERVISOR_MODEL=
SUPERVISOR_REASONING=
